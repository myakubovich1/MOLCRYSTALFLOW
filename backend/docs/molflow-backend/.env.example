# Use the same value as DESKTOP_BACKEND_TOKEN in the frontend .env.local.
MOLFLOW_API_TOKEN=replace-with-a-long-random-token

MOLFLOW_GENERATOR_BACKEND=ccdc_v2
MOLFLOW_V2_DEVICE=cuda:0
MOLFLOW_V2_NUM_TIMESTEPS=50

# "neutral" is executable without the missing lab preprocessing package.
# It uses PCA features and zero-valued placeholders for the nine normalized
# descriptors that were not included in the supplied model archive.
MOLFLOW_V2_FEATURE_MODE=neutral
MOLFLOW_V2_REQUIRE_EXACT_FEATURES=false

# Switch to these settings after the lab feature implementation is installed:
# MOLFLOW_V2_FEATURE_MODE=factory
# MOLFLOW_V2_FEATURE_FACTORY=lab_package.features:build_features
# MOLFLOW_V2_REQUIRE_EXACT_FEATURES=true

# UMA-s-1p2 ranking after geometry/clash filtering.
MOLFLOW_POTENTIAL_PROVIDER=uma
MOLFLOW_UMA_MODEL=uma-s-1p2
MOLFLOW_UMA_TASK_NAME=omat
MOLFLOW_POTENTIAL_DEVICE=cuda
MOLFLOW_POTENTIAL_DTYPE=float32
MOLFLOW_RIGID_BODY_STEPS=10

# Existing csp-pipeline checkout that contains the rigid-body optimizer.
MCF_ROOT=/home/liu-group/projects/MolCrystalFlow
CSP_DIR=/home/liu-group/projects/MolCrystalFlow/csp-pipeline
MOLFLOW_CSP_DIR=/home/liu-group/projects/MolCrystalFlow/csp-pipeline

# If automatic optimizer discovery cannot find the lab function, set this to
# the existing csp-pipeline function. Do not create a new optimizer here.
# Example shape:
# The packaged adapter wraps the lab csp-pipeline rigid constraint code and
# ASE BFGS rigid-body optimization pattern for one generated candidate.
# MOLFLOW_RIGID_BODY_FACTORY=app.rigid_body_adapter:optimize_rigid_body
